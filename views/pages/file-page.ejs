<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/styles/output.css">
    <link rel="icon" type="image/png" href="/assets/cloud.png">
    <title>FileDrop</title>
</head>

<body class="flex flex-col min-h-screen bg-[#f9fbff] w-screen">
    <%- include("../partials/navbar") %>
        <%- include("../partials/upload-file") %>
            <main class="max-w-6xl w-full flex flex-col flex-1 gap-5 pt-40 sm:pt-28  pb-5 px-6  mx-auto">
                <section class="w-full grow flex flex-col gap-3">
                    <div
                        class="flex flex-col items-center gap-5 grow bg-white border rounded-2xl border-[#d1e3ff] p-5 shadow-xs shadow-[#f3f9ffea] min-h-60 relative">
                        <img src="/assets/file.png" class="self-start w-8 mb-2" alt="folder icon">

                        <div class="flex flex-col items-center gap-10">
                            <h1 class="text-blue-500 text-2xl font-bold">
                                <%=file.name%>
                            </h1>
                            <iframe src="<%=file.file_url%>"
                                class="w-70 h-70 border rounded-2xl border-blue-500 p-5 shadow-xs shadow-[#f3f9ffea]"></iframe>

                            <span class="text-blue-500 font-semibold">Uploaded At:<span
                                    class="text-black italic font-normal">
                                    <%=file.upload_time%>
                                </span></span>
                            <span class="text-blue-500 font-semibold">File Size:<span
                                    class="text-black italic font-normal">
                                    <%=file.file_size%>
                                </span></span>
                            <div class="flex gap-4">
                                <a href="<%=file.download_url%>"
                                    class="bg-blue-500 px-5 py-1.5 text-white rounded-xl hover:bg-blue-300 transition-all duration-300 ease-in-out">Download</a>
                                <form action="/file/<%=file.id%>/delete" method="POST">
                                    <button
                                        class="bg-red-500 px-5 py-1.5 text-white rounded-xl hover:bg-red-300 transition-all duration-300 ease-in-out"
                                        type="submit">Delete File</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </section>
            </main>

            <%- include("../partials/footer") %>
</body>

</html>