<header class="fixed w-screen bg-white">
    <nav class="flex flex-col sm:flex-row gap-5 justify-between items-center py-4 px-6 shadow-sm">
        <a href="/" class="flex gap-2">
            <img class="w-9" src="/assets/cloud.png" alt="Cloud Icon">
            <h1 class="text-[1.8rem] font-semibold">File<span class="text-blue-500">Drop</span></h1>
        </a>
        <div>
            <% if (locals.user) { %>
                <a class="inline-block bg-blue-500 p-2 text-white rounded-xl  hover:bg-blue-300 transition-all duration-300 ease-in-out"
                    href="/auth/log-out">Log Out</a>
                <%} else {%>
                    <a class="inline-block hover:text-gray-500 transition-all duration-300 ease-in-out"
                        href="/auth/log-in">Log
                        In</a>
                    <a class="text-white bg-blue-500 hover:bg-blue-300 transition-all duration-300 ease-in-out py-2.5 px-3 rounded-xl ml-3 text-nowrap inline-block"
                        href="/auth/sign-up">Sign
                        Up</a>
                    <%}%>


        </div>
    </nav>
</header>